{
  "env": {
    "PYTHONPATH": "src"
  },
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make check-memory)",
      "Bash(make check-migrations)",
      "Bash(make setup)",
      "Bash(make *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(pytest *)",
      "Bash(alembic *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__actions_list"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
